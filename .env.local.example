# Machine-specific paths for bin/wp-local. Copy to .env.local (gitignored)
# in the main checkout. Lines are KEY=VALUE; nothing here is executed.
#
# LOCAL_SITE_ID: the site's key in ~/Library/Application Support/Local/sites.json
LOCAL_SITE_ID=your-local-site-id

# Local's PHP binary for this site's PHP version (match services.php.version).
LOCAL_PHP_BIN=~/Library/Application Support/Local/lightning-services/php-8.4.18+1/bin/darwin-arm64/bin/php

# Local's bundled WP-CLI phar.
LOCAL_WP_CLI=/Applications/Local.app/Contents/Resources/extraResources/bin/wp-cli/wp-cli.phar

# Optional: Local's MySQL client binaries (mysqldump for `db export`).
LOCAL_MYSQL_BIN=~/Library/Application Support/Local/lightning-services/mysql-8.4.0+2/bin/darwin-arm64/bin

# The WordPress root (the directory containing wp-load.php).
WP_PATH=~/Sites/blammo.local/app/public
