{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "blammo/hello-world",
	"version": "0.1.0",
	"title": "Hello World",
	"category": "blammo",
	"icon": "smiley",
	"description": "A simple block that renders a \"Hello, world!\" greeting.",
	"keywords": ["hello", "greeting"],
	"textdomain": "blammo",
	"attributes": {
		"name": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"color": {
			"text": true,
			"background": true
		},
		"spacing": {
			"margin": true,
			"padding": true
		},
		"typography": {
			"fontSize": true
		}
	},
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
